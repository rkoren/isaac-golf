#usda 1.0
(
    defaultPrim = "golfer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "golfer" (
    prepend references = @./humanoid.usda@
)
{
    def Xform "club" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/left_hand>,
            </golfer/right_hand>,
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
        float physics:mass = 0.31

        def Cube "head" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.04, 0.1, 0.05)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }

        def Capsule "shaft" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.84
            double radius = 0.015
            double3 xformOp:translate = (0, 0, 0.435)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsFixedJoint "club_weld"
    {
        rel physics:body0 = </golfer/left_hand>
        rel physics:body1 = </golfer/club>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0.85)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (0.29709, 0.56742, 0.76116, -0.10201)
    }

    over "left_hand" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/right_hand>,
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
    }

    over "right_hand" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
    }

    over "left_lower_arm" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = </golfer/right_lower_arm>
    }
}


#usda 1.0
(
    defaultPrim = "golfer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "golfer" (
    prepend references = @./humanoid.usda@
)
{
    def Xform "club" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.31

        def Cube "head" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.02, 0.05, 0.025)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }

        def Capsule "shaft" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.84
            double radius = 0.015
            double3 xformOp:translate = (0, 0, 0.435)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsFixedJoint "club_weld"
    {
        rel physics:body0 = </golfer/left_hand>
        rel physics:body1 = </golfer/club>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0.85)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (0.00377, 0.79605, 0.25261, -0.54958)
    }
}


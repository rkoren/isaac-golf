#usda 1.0
(
    defaultPrim = "golfer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "golfer" (
    prepend references = @./humanoid.usda@
)
{
    def Xform "club" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0.1311)
        float3 physics:diagonalInertia = (0.0173679, 0.017288849, 0.00011268333)

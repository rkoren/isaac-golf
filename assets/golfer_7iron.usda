        )
        {
            uniform token axis = "Z"
            double height = 0.18000000000000005
            rel material:binding = </golfer/club/Looks/rubber>
            double radius = 0.0105
            quatf xformOp:orient = (0.99978215, 0.018813798, 0.009040355, -0)
            double3 xformOp:translate = (-0.0016269092628571954, 0.0033857458194368746, 0.6050784236598545)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    def PhysicsFixedJoint "club_weld"
    {
        rel physics:body0 = </golfer/left_hand>
        rel physics:body1 = </golfer/club>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0.69)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (0.26959, 0.65122, 0.69542, -0.14012)
    }

    over "left_hand" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/right_hand>,
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
    }

    over "right_hand" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
    }

    over "left_lower_arm" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = </golfer/right_lower_arm>
    }
}


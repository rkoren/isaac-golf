#usda 1.0
(
    defaultPrim = "golfer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "golfer" (
    prepend references = @./humanoid.usda@
)
{
    def Xform "club" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/left_hand>,
            </golfer/right_hand>,
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
        float physics:mass = 0.42

        def Cube "head" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.02, 0.065, 0.042)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }

        def Capsule "shaft" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.65
            uniform token purpose = "guide"
            double radius = 0.015
            double3 xformOp:translate = (0, 0, 0.34)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "look"

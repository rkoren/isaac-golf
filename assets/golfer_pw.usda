        def "Looks"
        {
            def Material "chrome"
            {
                token outputs:surface.connect = </golfer/club/Looks/chrome/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.75, 0.76, 0.78)
                    float inputs:metallic = 1
                    float inputs:roughness = 0.2
                    token outputs:surface
                }
            }

            def Material "steel"
            {
                token outputs:surface.connect = </golfer/club/Looks/steel/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                    float inputs:metallic = 1
                    float inputs:roughness = 0.3
                    token outputs:surface
                }
            }

            def Material "rubber"
            {
                token outputs:surface.connect = </golfer/club/Looks/rubber/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.04, 0.04, 0.04)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.8
                    token outputs:surface
                }
            }
        }

        def Cylinder "hosel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.04
            rel material:binding = </golfer/club/Looks/steel>
            double radius = 0.0075
            quatf xformOp:orient = (0.99968684, 0.021968994, 0.011982627, -0)
            double3 xformOp:translate = (-0.015219626377598064, 0.027903719879752507, 0.030526193056005704)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "shaft_look" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.6552694438647324
            rel material:binding = </golfer/club/Looks/steel>
            double radius = 0.0055
            quatf xformOp:orient = (0.99968684, 0.021968994, 0.011982627, -0)
            double3 xformOp:translate = (-0.007849390686577105, 0.014391102219655949, 0.33777562092892316)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "grip_look" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.18
            rel material:binding = </golfer/club/Looks/rubber>
            double radius = 0.0105
            quatf xformOp:orient = (0.99968684, 0.021968994, 0.011982627, -0)
            double3 xformOp:translate = (-0.0021561974800026577, 0.003953180518017269, 0.5751127196082828)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    def PhysicsFixedJoint "club_weld"
    {
        rel physics:body0 = </golfer/left_hand>
        rel physics:body1 = </golfer/club>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0.66)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (0.26864, 0.65449, 0.69883, -0.10537)
    }

    over "left_hand" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/right_hand>,
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
    }

    over "right_hand" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
    }

    over "left_lower_arm" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = </golfer/right_lower_arm>
    }
}


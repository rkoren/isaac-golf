        def "Looks"
        {
            def Material "crown"
            {
                token outputs:surface.connect = </golfer/club/Looks/crown/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.03, 0.03, 0.035)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.35
                    token outputs:surface
                }
            }

            def Material "face"
            {
                token outputs:surface.connect = </golfer/club/Looks/face/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                    float inputs:metallic = 1
                    float inputs:roughness = 0.3
                    token outputs:surface
                }
            }

            def Material "steel"
            {
                token outputs:surface.connect = </golfer/club/Looks/steel/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                    float inputs:metallic = 1
                    float inputs:roughness = 0.3
                    token outputs:surface
                }
            }

            def Material "rubber"
            {
                token outputs:surface.connect = </golfer/club/Looks/rubber/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.04, 0.04, 0.04)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.8
                    token outputs:surface
                }
            }
        }

        def Cylinder "hosel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.04000000000000001
            rel material:binding = </golfer/club/Looks/steel>
            double radius = 0.0075
            quatf xformOp:orient = (0.9998947, 0.01364833, -0.0049315766, 0)
            double3 xformOp:translate = (0.007802757706662944, 0.021594435341478535, 0.06414819085656001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "shaft_look" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.8111850521154947
            rel material:binding = </golfer/club/Looks/steel>
            double radius = 0.0055
            quatf xformOp:orient = (0.9998947, 0.01364833, -0.0049315766, 0)
            double3 xformOp:translate = (0.004, 0.011070155528750344, 0.44957830737555027)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cylinder "grip_look" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.18
            rel material:binding = </golfer/club/Looks/rubber>
            double radius = 0.0105
            quatf xformOp:orient = (0.9998947, 0.01364833, -0.0049315766, 0)
            double3 xformOp:translate = (0.000887590320016755, 0.0024564407220996915, 0.7650379075254325)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    def PhysicsRevoluteJoint "lead_wrist" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        uniform token physics:axis = "Y"
        rel physics:body0 = </golfer/left_hand>
        rel physics:body1 = </golfer/club>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0.85)
        quatf physics:localRot0 = (0.30447057, -0.5593411, -0.7638114, 0.1050202)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -25
        float physics:upperLimit = 70
    }

    over "left_hand" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/right_hand>,
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
    }

    over "right_hand" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = [
            </golfer/left_lower_arm>,
            </golfer/right_lower_arm>,
        ]
    }

    over "left_lower_arm" (
        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
    )
    {
        rel physics:filteredPairs = </golfer/right_lower_arm>
    }
}

